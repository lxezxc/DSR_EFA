{
    "dataset": {
        "dataset_name": "CREMA-D",
        "data_root":"/data/zyh_2025/CREMAD"
    },

    "db_file_paths":[
        "/data/lxe/multimodel/NeurIPS24-LFM-main/embeddings/embeddings_l2_train_audio.npy",
        "/data/lxe/multimodel/NeurIPS24-LFM-main/embeddings/embeddings_l2_train_joint_video.npy",
        "/data/lxe/multimodel/NeurIPS24-LFM-main/embeddings/embeddings_raw_train_audio.npy",
        "/data/lxe/multimodel/NeurIPS24-LFM-main/embeddings/embeddings_raw_train_joint_video.npy",
        "/data/lxe/multimodel/NeurIPS24-LFM-main/embeddings/labels_train_audio.npy",
        "/data/lxe/multimodel/NeurIPS24-LFM-main/embeddings/labels_train_joint_video.npy"
    ],
    
    "visual": {
        "name": "resnet18"
    },
    "text": {
        "name": "resnet18"
    },
    "loss": {
        "type": "CrossEntropy"
    },
    "train": {
        "epoch_dict" : 250,
        
        "lower_a" : 0.3,
        
        "upper_a" : 0.7,
        "lower_v" : 0.3,

        "upper_v" : 0.7,
        
        "merge_alpha" : 0.5,
        "epoch_thre" : -1,
        "thre_sample" : 32,
        "thre_sample_min" : 2,
        "warmup_epochs" : 20,
        
        "batch_size":8,
        "mixup_alpha": 1.0,
        "num_workers":8,
        "flat_ratio": 0.3,
        "noise_ratio": 1.0e-10,
        "noise_ratio_cls":1.0e-10,
        "temperature1": 1.0,
        "optimizer": {
            "type": "SGD",
            "momentum": 0.9,
            "lr":1e-2,
            "wc" : 1.0e-4
        },
        "lr_scheduler":{
            "type": "warmup",
            "lr_step": [160, 180],
            "lr_factor": 0.1,
            "warmup_epoch": 2,
            "patience": 70,
            "patience_ori": 70
        }
    },
    
    "test": {
        "batch_size":64,
        "num_workers":8
    },
    "setting": {
        "type": "CREMA Classification",
        "num_class": 6,
        "num_layers": 10
    },
    "seed": 0,
    "gpu_id": "3",

    "image_res": 224,
    "debug": false,
    "fps":1
}
